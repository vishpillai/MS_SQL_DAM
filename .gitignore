**/bin/
**/obj/
.vs/
*.user
*.suo
*.log
**/App_Data/

# WiX Toolset local extension/tool restore cache (regenerated by `wix build`)
.wix/
installer/.wix/

# dotnet publish output consumed by the MSI build (regenerated by Build-Msi.ps1)
installer/publish/

# Generated WiX component manifest (regenerated by GenerateFiles.ps1)
installer/Files.wxs

# Build-time artifact scratch space
artifacts/

# Local verification builds and databases; never publish runtime data.
/_bootstrap-verification/
/_build-check/
/_build-check2/
/_perf-check/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-*

# Generated Windows and Linux installer packages.
installer/*.msi
installer/*.wixpdb
installer-linux/.staging-*/
installer-linux/dist/
