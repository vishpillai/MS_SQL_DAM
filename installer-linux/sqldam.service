[Unit]
Description=SQL DAM Database Activity Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sqldam
Group=sqldam
EnvironmentFile=/etc/sqldam/sqldam.env
Environment="LD_LIBRARY_PATH=/opt/sqldam/clidriver/lib:/opt/sqldam/clidriver/lib/icc"
WorkingDirectory=/opt/sqldam
ExecStart=/opt/sqldam/SqlDam.Web
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sqldam
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
